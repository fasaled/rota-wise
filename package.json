{
  "name": "rota-wise",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side PWA for fair doctor on-call scheduling",
  "license": "AGPL-3.0-or-later",
  "author": "Francisco Sánchez",
  "repository": {
    "type": "git",
    "url": "https://github.com/fasaled/rota-wise.git"
  },
  "homepage": "https://rotawise.fasl.dev",
  "bugs": {
    "url": "https://github.com/fasaled/rota-wise/issues"
  },
  "keywords": [
    "scheduling",
    "rota",
    "doctors",
    "pwa",
    "healthcare"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "e2e:desktop": "bun e2e/run-desktop.ts",
    "desktop:dev": "deno desktop --hmr -A .",
    "desktop:build": "vite build --mode desktop && deno desktop --no-npm --exclude node_modules --allow-read --allow-net --allow-env --include dist --no-prompt desktop/main.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx": "^9.5.0",
    "lucide-react": "^0.475.0",
    "react": "^19.2.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.3",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0"
  }
}
