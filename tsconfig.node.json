{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "eslint.config.js", "tailwind.config.ts", "postcss.config.mjs"]
}
